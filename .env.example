# Copy to .env; install requirements-ai.txt before choosing openecg.
ECG_MODEL_TYPE=none

# External explanations use process environment variables.
# The explanation generator does not currently load these keys from .env.
ECG_EXPLANATION_PROVIDER=template
ECG_LLM_MODEL=deepseek-chat
ECG_LLM_TIMEOUT=10
DEEPSEEK_API_KEY=
